# Snakemake Grand production pipeline
# Should be launched with :
# conda activate /sps/grand/prod_grand/conda/snake
# snakemake --directory /sps/grand/prod_grand/DB_TESTS/TEST_SLURM/data/gp80/logs/ \
# --snakefile  /sps/grand/prod_grand/DB_TESTS/grand/scripts/pipeline/Snakefile \
# --config dbfile=/sps/grand/prod_grand/DB_TESTS/TEST_SLURM/20250905224520_GP80_dbfile.db \
# --cores 1 --profile ccin2p3 --keep-going \
# --restart-times 5


# Steps:
# 0) Get list of files to process
# 1) Register transfer of files (all bin files)
# 2) convert bin to root (individual bin files, max 50 in parallel)
# 3) Push to irods (individual root files, max 5 process in parralel)
# 4) Register convertion to database (individual root files, max 5 in parallel)
# 5) Register root files to database (individual root files, max 5 in parallel)
# 6) Refresh materialized views (after all previous steps)
# 7) Run monitoring (after bin to root convertion of all files)
# 8) Archive (after bin to root convertion of all files)
# 9) Clean logs (after all previous steps)
# 10) Notify (after all steps)

