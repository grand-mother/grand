     "name": "stdout",
     "output_type": "stream",
     "text": [
      "True time max: 999.0 ns\n"
     ]
    }
   ],
   "source": [
    "time_max = (x_max / step) * tr3d.get_delta_t_ns()[0]\n",
    "print(f'True time max: {time_max} ns')"
   ]
