# Ignore the dist/version module
grand/version.py

# Ignore shared libraries
*.so

# Ignore Python bytecode
__pycache__
*.pyc
*.pyo

# jupyterlab checkpoints
.ipynb_checkpoints




# Ignore build and dist temporaries
dist
src/build*
*.egg-info
*.whl


# Ignore the Python engine
python3-*.AppImage
python3-*.AppDir

# Ignore PyCharm stuff
.idea

# Ignore local librairies and data
lib/python*
grand/libs/lib*.so
grand/tools/data/topography
tests/topography
tests/simulation/data

# Ignore user data
user/grand

# Ignore quality report
.mypy_cache
.pytest_cache
.coverage
.scannerwork
quality/report_*
quality/html_*

# Ignore eclipse config files
.project
.pydevproject
.settings

